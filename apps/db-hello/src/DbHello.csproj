<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Unlike apps/hello, this one cannot run invariant: Microsoft.Data.SqlClient
         throws `NotSupportedException: Globalization Invariant Mode is not
         supported` the moment it opens a connection, so the first page view
         fails with a 500. Nothing in this app formats for a culture, but the
         driver requires real ICU data regardless — which is why the Dockerfile
         serves from the `-chiseled-extra` runtime image rather than `-chiseled`.
         Change one and the other has to follow. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The chiseled runtime image starts the app as "dotnet db-hello.dll". -->
    <AssemblyName>db-hello</AssemblyName>
    <RootNamespace>OneK8s.DbHello</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure.Identity mints the Entra token from the projected ServiceAccount
         token the workload identity webhook mounts; the interceptor in Data/
         attaches it to the connection EF Core opens. Between them they are the
         entire "no password" story. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!-- Design-time only: what `dotnet ef migrations add` and
         `dotnet ef database update` need. PrivateAssets keeps it out of the
         published image, which runs migrations never. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
